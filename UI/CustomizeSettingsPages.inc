// ---------------------------------------------------------------------------------------------
// Editable color state, saved next to the custom theme so it survives restarts.
// ---------------------------------------------------------------------------------------------

struct EditState {
	int bg[3] = { 13, 20, 32 };
	int tile[3] = { 255, 255, 255 };
	int tileAlpha = 20;  // 0-255, how visible the tile background is.
	int focus[3] = { 242, 245, 250 };
	int popup[3] = { 20, 28, 43 };
	int accent[3] = { 0, 112, 209 };
	int radius = 14;
	bool lightText = true;
	bool loaded = false;
};

static EditState g_edit;

struct IntField {
	const char *name;
	int *value;
};

static std::vector<IntField> EditFields() {
	EditState &s = g_edit;
	return {
		{ "bgR", &s.bg[0] }, { "bgG", &s.bg[1] }, { "bgB", &s.bg[2] },
		{ "tileR", &s.tile[0] }, { "tileG", &s.tile[1] }, { "tileB", &s.tile[2] },
		{ "tileAlpha", &s.tileAlpha },
		{ "focusR", &s.focus[0] }, { "focusG", &s.focus[1] }, { "focusB", &s.focus[2] },
		{ "popupR", &s.popup[0] }, { "popupG", &s.popup[1] }, { "popupB", &s.popup[2] },
		{ "accentR", &s.accent[0] }, { "accentG", &s.accent[1] }, { "accentB", &s.accent[2] },
		{ "radius", &s.radius },
	};
}

static Path ThemeDir() {
	return GetSysDirectory(DIRECTORY_CUSTOM_THEMES);
}

// The .ini is the theme itself. The state file is .txt on purpose: Theme.cpp treats every .ini
// in this folder as a theme.
static Path ThemeFile() {
	return ThemeDir() / "custom_theme.ini";
}

static Path StateFile() {
	return ThemeDir() / "custom_theme_state.txt";
}

static void LoadEditState() {
	if (g_edit.loaded) {
		return;
	}
	g_edit.loaded = true;
	std::ifstream in(StateFile().ToString());
	std::string line;
	while (std::getline(in, line)) {
		size_t eq = line.find('=');
		if (eq == std::string::npos) {
			continue;
		}
		std::string key = line.substr(0, eq);
		int val = atoi(line.c_str() + eq + 1);
		if (key == "lightText") {
			g_edit.lightText = val != 0;
			continue;
		}
		for (const IntField &f : EditFields()) {
			if (key == f.name) {
				*f.value = std::clamp(val, 0, 255);
			}
		}
	}
}

static void SaveEditState() {
	File::CreateFullPath(ThemeDir());
	std::ofstream out(StateFile().ToString(), std::ios::trunc);
	for (const IntField &f : EditFields()) {
		out << f.name << "=" << *f.value << "\n";
	}
	out << "lightText=" << (g_edit.lightText ? 1 : 0) << "\n";
}

// ---------------------------------------------------------------------------------------------
// Theme file generation. Colors in theme files are written as #RRGGBBAA.
// ---------------------------------------------------------------------------------------------

static std::string Hex(int r, int g, int b, int a) {
	char buf[16];
	snprintf(buf, sizeof(buf), "#%02X%02X%02X%02X", std::clamp(r, 0, 255), std::clamp(g, 0, 255), std::clamp(b, 0, 255), std::clamp(a, 0, 255));
	return buf;
}

static bool IsLight(const int c[3]) {
	return (0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]) > 140.0;
}

static std::string BuildThemeIni(const EditState &s) {
	const char *tileFg = s.lightText ? "#FFFFFFFF" : "#000000FF";
	const char *tileFgDim = s.lightText ? "#FFFFFF66" : "#00000066";
	const char *infoFg = s.lightText ? "#FFFFFFCC" : "#000000CC";
	// Text on the highlighted tile flips to stay readable on light or dark highlights.
	const char *focusFg = IsLight(s.focus) ? "#0B1018FF" : "#FFFFFFFF";

	std::ostringstream o;
	o << "# Generated by the Customize > Colors page. Edits made there overwrite this file.\n";
	o << "[MyCustomTheme]\n";
	o << "Name = \"My Custom\"\n\n";
	o << "BackgroundColor = \"" << Hex(s.bg[0], s.bg[1], s.bg[2], 255) << "\"\n";
	o << "ScrollbarColor = \"#FFFFFF55\"\n\n";

	o << "ItemStyleFg = \"" << tileFg << "\"\n";
	o << "ItemStyleBg = \"" << Hex(s.tile[0], s.tile[1], s.tile[2], s.tileAlpha) << "\"\n";
	o << "ItemFocusedStyleFg = \"" << focusFg << "\"\n";
	o << "ItemFocusedStyleBg = \"" << Hex(s.focus[0], s.focus[1], s.focus[2], 255) << "\"\n";
	o << "ItemDownStyleFg = \"" << focusFg << "\"\n";
	o << "ItemDownStyleBg = \"" << Hex(s.focus[0] * 3 / 4, s.focus[1] * 3 / 4, s.focus[2] * 3 / 4, 255) << "\"\n";
	o << "ItemDisabledStyleFg = \"" << tileFgDim << "\"\n";
	o << "ItemDisabledStyleBg = \"" << Hex(s.tile[0], s.tile[1], s.tile[2], s.tileAlpha / 2) << "\"\n\n";

	o << "HeaderStyleFg = \"" << tileFg << "\"\n";
	o << "HeaderStyleBg = \"#00000000\"\n";
	o << "CollapsibleHeaderStyleFg = \"" << tileFg << "\"\n";
	o << "CollapsibleHeaderStyleBg = \"" << Hex(s.tile[0], s.tile[1], s.tile[2], std::min(255, s.tileAlpha + 15)) << "\"\n";
	o << "InfoStyleFg = \"" << infoFg << "\"\n";
	o << "InfoStyleBg = \"#00000000\"\n";
	o << "TooltipStyleFg = \"" << tileFg << "\"\n";
	o << "TooltipStyleBg = \"" << Hex(s.popup[0], s.popup[1], s.popup[2], 240) << "\"\n\n";

	o << "PopupStyleFg = \"" << tileFg << "\"\n";
	o << "PopupStyleBg = \"" << Hex(s.popup[0], s.popup[1], s.popup[2], 245) << "\"\n";
	o << "PopupTitleStyleFg = \"" << tileFg << "\"\n";
	o << "PopupTitleStyleBg = \"#00000000\"\n";
	o << "PopupSliderColor = \"" << tileFg << "\"\n";
	o << "PopupSliderFocusedColor = \"" << Hex(s.accent[0], s.accent[1], s.accent[2], 255) << "\"\n\n";

	o << "ChoiceRoundRadius = " << s.radius << "\n";
	return o.str();
}

// Writes the theme, reloads the theme list, switches to it and rebuilds all screens.
static void ApplyCustomTheme(SettingsPageHost *host) {
	File::CreateFullPath(ThemeDir());
	{
		std::ofstream out(ThemeFile().ToString(), std::ios::trunc);
		if (!out) {
			System_Toast("Couldn't write the custom theme file");
			return;
		}
		out << BuildThemeIni(g_edit);
	}
	SaveEditState();
	ReloadAllThemeInfo();
	g_Config.sThemeName = "My Custom";
	UpdateTheme();
	host->PageScreenManager()->RecreateAllViews();
}

// ---------------------------------------------------------------------------------------------
// Presets
// ---------------------------------------------------------------------------------------------

struct Preset {
	const char *name;
	int bg[3];
	int tile[3];
	int tileAlpha;
	int focus[3];
	int popup[3];
	int accent[3];
	int radius;
	bool lightText;
};

static const Preset kPresets[] = {
	{ "PS5 Slate",     {  13,  20,  32 }, { 255, 255, 255 },  20, { 242, 245, 250 }, {  20,  28,  43 }, {   0, 112, 209 }, 14, true },
	{ "PS5 Home",      {  21,  11,  51 }, { 255, 255, 255 },  22, { 255, 255, 255 }, {  30,  16,  72 }, { 122,  92, 255 }, 16, true },
	{ "Midnight OLED", {   0,   0,   0 }, { 255, 255, 255 },  16, { 230, 230, 235 }, {  12,  12,  16 }, {  80, 160, 255 }, 10, true },
	{ "Ice White",     { 232, 238, 247 }, {   0,   0,   0 },  14, {  20,  60, 130 }, { 244, 247, 252 }, {   0, 112, 209 }, 14, false },
	{ "Gold Edition",  {  22,  17,   8 }, { 255, 240, 200 },  20, { 201, 162,  39 }, {  34,  27,  12 }, { 235, 190,  60 }, 12, true },
};

static void CopyPreset(const Preset &p) {
	EditState &s = g_edit;
	memcpy(s.bg, p.bg, sizeof(s.bg));
	memcpy(s.tile, p.tile, sizeof(s.tile));
	memcpy(s.focus, p.focus, sizeof(s.focus));
	memcpy(s.popup, p.popup, sizeof(s.popup));
	memcpy(s.accent, p.accent, sizeof(s.accent));
	s.tileAlpha = p.tileAlpha;
	s.radius = p.radius;
	s.lightText = p.lightText;
}

// Keeps a string alive for the lifetime of the program (SettingText only stores a pointer).
static const char *Persist(const std::string &s) {
	static std::set<std::string> store;
	return store.insert(s).first->c_str();
}

// ---------------------------------------------------------------------------------------------
// Pages
// ---------------------------------------------------------------------------------------------

static void BuildThemePage(SettingsPage *page) {
	SettingsPageHost *host = page->Host();

	page->Header("Active theme");
	page->Info("Current", g_Config.sThemeName);

	page->Header("Installed themes");
	page->Description("Tap a theme to apply it right away. Themes come from the app's themes folder and from your memory stick's custom themes folder.");
	for (const std::string &name : GetThemeInfoNames()) {
		std::string themeName = name;
		page->Choice(SettingText::Raw(Persist(name))).OnClick([host, themeName](UI::EventParams &) {
			g_Config.sThemeName = themeName;
			UpdateTheme();
			host->PageScreenManager()->RecreateAllViews();
		});
	}
}

static void AddRgb(SettingsPage *page, int *c, const int *defaults, const char *title, const char *r, const char *g, const char *b) {
	page->Header(title);
	page->IntSlider(&c[0], 0, 255, r).Default(defaults[0]).Step(5);
	page->IntSlider(&c[1], 0, 255, g).Default(defaults[1]).Step(5);
	page->IntSlider(&c[2], 0, 255, b).Default(defaults[2]).Step(5);
}

static void BuildColorsPage(SettingsPage *page) {
	LoadEditState();
	SettingsPageHost *host = page->Host();
	const Preset &base = kPresets[0];

	page->Header("Start from a preset");
	page->Description("Pick a preset to fill in all the sliders and apply it. Then fine-tune below and tap Apply colors.");
	for (const Preset &p : kPresets) {
		const Preset *preset = &p;
		page->Choice(p.name).OnClick([host, preset](UI::EventParams &) {
			CopyPreset(*preset);
			ApplyCustomTheme(host);
		});
	}

	page->Header("Apply");
	page->Choice("Apply colors").OnClick([host](UI::EventParams &) {
		ApplyCustomTheme(host);
	}).Hint("Saves your colors as the \"My Custom\" theme and switches to it.");

	AddRgb(page, g_edit.bg, base.bg, "Background", "Background red", "Background green", "Background blue");
	AddRgb(page, g_edit.tile, base.tile, "Tiles and buttons", "Tile red", "Tile green", "Tile blue");
	page->IntSlider(&g_edit.tileAlpha, 0, 255, "Tile opacity").Default(base.tileAlpha).Step(5);
	page->Bool(&g_edit.lightText, "Light text on tiles").Hint("Turn off for light backgrounds, so the text turns dark.");
	AddRgb(page, g_edit.focus, base.focus, "Highlight (selected item)", "Highlight red", "Highlight green", "Highlight blue");
	AddRgb(page, g_edit.popup, base.popup, "Popups and tooltips", "Popup red", "Popup green", "Popup blue");
	AddRgb(page, g_edit.accent, base.accent, "Accent (slider handles)", "Accent red", "Accent green", "Accent blue");

	page->Header("Shape");
	page->IntSlider(&g_edit.radius, 0, 32, "Corner radius").Default(base.radius).Step(1);

	page->Header("Apply");
	page->Choice("Apply colors").OnClick([host](UI::EventParams &) {
		ApplyCustomTheme(host);
	});
}

static void BuildLayoutPage(SettingsPage *page) {
	page->Header("Home screen");
	page->Bool(&g_Config.bPS5Home, "PS5-style home screen").Hint("Turn off to go back to the classic list. Applies when you return to the home screen.");
	page->Bool(&g_Config.bPS5FavoritesFirst, "Favorites first").Hint("In Games and Homebrew, your favorite games come first.").Enabled(&g_Config.bPS5Home);

	page->Header("Tiles");
	page->IntSlider(&g_Config.iPS5TileScale, 60, 150, "Tile size").Default(100).Step(5).Enabled(&g_Config.bPS5Home);

	page->Header("Artwork");
	page->IntSlider(&g_Config.iPS5HeroDim, 0, 90, "Artwork dimming").Default(45).Step(5).Enabled(&g_Config.bPS5Home);

	page->Header("Show on the home screen");
	page->Bool(&g_Config.bPS5ShowClock, "Clock").Enabled(&g_Config.bPS5Home);
	page->Bool(&g_Config.bPS5ShowDescription, "Game description").Enabled(&g_Config.bPS5Home);
	page->Bool(&g_Config.bPS5ShowHints, "Button hints").Enabled(&g_Config.bPS5Home);
}

static void BuildAnimationsPage(SettingsPage *page) {
	page->Header("Reduced motion");
	page->Bool(&g_Config.bPS5ReducedMotion, "Reduced motion").Hint("No zoom, no slide-in, a steady glow, and games start without the fade.").Enabled(&g_Config.bPS5Home);

	page->Header("Selected tile");
	page->IntSlider(&g_Config.iPS5FocusScale, 100, 150, "Selected tile zoom").Default(108).Step(2).Enabled(&g_Config.bPS5Home);
	page->Bool(&g_Config.bPS5Glow, "Glow on selected tile").Enabled(&g_Config.bPS5Home);

	page->Header("Speed");
	page->IntSlider(&g_Config.iPS5AnimSpeed, 25, 300, "Animation speed").Default(100).Step(25).Enabled(&g_Config.bPS5Home);
	page->Description("Higher is faster. This controls how quickly tiles zoom, the title slides in, and the home screen fades when a game starts.");

	page->Header("Background");
	page->Setting(&g_Config.iBackgroundAnimation);
}

static void BuildArtworkPage(SettingsPage *page) {
	page->Header("Your own thumbnails, artwork and descriptions");
	page->Description("Open a game's page (hold the game, or use its info button). There you'll find Custom thumbnail, Custom artwork, Custom description and Reset custom look.");
	page->Description("The thumbnail is the small picture on the tile. The artwork is the big picture behind the home screen. The description is the text under the game's title.");

	page->Header("Tips");
	page->Description("Use PNG or JPEG images under 6 MB. Wide images (like 16:9) work best for artwork, and landscape ones for thumbnails.");
	page->Description("Your files are kept per game, in the folder below. If you move a game file to another folder, it starts fresh.");

	page->Header("Where they're stored");
	page->Info("Folder", Persist((GetSysDirectory(DIRECTORY_SYSTEM) / "CUSTOM_ART").ToString()));
}

static void AddStatusFlag(SettingsPage *page, const char *label, ShowStatusFlags flag) {
	page->Bool(label, [flag]() {
		return (g_Config.iShowStatusFlags & (int)flag) != 0;
	}, [flag](bool value) {
		if (value) {
			g_Config.iShowStatusFlags |= (int)flag;
		} else {
			g_Config.iShowStatusFlags &= ~(int)flag;
		}
	});
}

static void BuildPerformancePage(SettingsPage *page) {
	page->Header("While playing");
	AddStatusFlag(page, "Show FPS counter", ShowStatusFlags::FPS_COUNTER);
	AddStatusFlag(page, "Show speed", ShowStatusFlags::SPEED_COUNTER);
	AddStatusFlag(page, "Show battery", ShowStatusFlags::BATTERY_PERCENT);
	page->Description("These are PPSSPP's own readouts, drawn over the game while it runs. You can also switch them from the pause menu.");
}

static void BuildSoundsPage(SettingsPage *page) {
	page->Header("Menu sounds");
	page->Bool(&g_Config.bUISound, "Enable UI sounds").Hint("Plays the sounds bundled with this build when you move, select and go back.");
	page->IntSlider(&g_Config.iUIVolume, 0, 100, "UI volume").Default(75).Step(5).Enabled(&g_Config.bUISound);

	page->Header("What plays when");
	page->Description("Select: moving the highlight. Confirm: choosing an item. Back: leaving a screen. Toggle on/off: checkboxes.");
	page->Description("Category switch: changing tabs. Launch: starting a game. Panel: opening and closing a game's page. Settings: opening Settings. Popup: dialogs. Pause: opening and closing the pause menu. Save: saving a state.");
	page->Description("Two longer sounds play for achievements and leaderboard submissions.");
}

static void BuildGuidePage(SettingsPage *page) {
	page->Header("Quick start");
	page->Description("1. Open Theme and tap PS5 Slate or PS5 Home to switch the whole interface at once.");
	page->Description("2. Open Layout to turn the PS5-style home screen on or off and resize its tiles.");
	page->Description("3. Open Artwork to learn how to give any game its own thumbnail, artwork and description.");
	page->Description("4. Open Colors to build your own theme, and Sounds and Animations to tune the feel.");

	page->Header("Using the home screen");
	page->Description("Tap a game once to select it: the tile zooms, the artwork and title appear, and your description shows. Tap it again to play. Hold it for its page, where you can customize it.");
	page->Description("With a gamepad or keyboard, move to a tile to select it and press confirm to play. L1 and R1 switch categories. The search bar above the tiles filters the current list.");
	page->Description("Prefer less movement? Turn on Reduced motion under Animations.");

	page->Header("Favorites");
	page->Description("Open a game's page and tap Add to favorites. Favorites get a gold FAV tag, come first in Games and Homebrew, and have their own Favorites tab (it appears once you have one).");

	page->Header("Colors, explained");
	page->Description("Background is the backdrop behind every screen. Tiles are the buttons and rows. Tile opacity controls how visible they are against the background; low values look glassy.");
	page->Description("Highlight is the item you've selected. Its text switches between dark and light automatically so it stays readable. Popups is the color of dialogs and tooltips. Accent colors slider handles.");
	page->Description("Light text on tiles should be on for dark backgrounds and off for light ones.");

	page->Header("Good to know");
	page->Description("Apply colors creates a theme called My Custom and switches to it. Your sliders are remembered between launches.");
	page->Description("To go back to the standard look, open Theme and tap Default. Nothing is deleted.");
	page->Description("Layout and animation changes show up when you return to the home screen.");
}

}  // namespace customize

static void BuildCustomizeSettings(SettingsPage *page) {
	using namespace customize;
	LoadEditState();

	page->Header("Customize");
	page->Description("Change how PPSSPP looks, moves and sounds. Start with Theme for one-tap looks. Layout, Animations and Artwork shape the home screen. Guide explains everything.");

	page->Link("Theme", I18NCat::MAINSETTINGS, &BuildThemePage);
	page->Link("Colors", I18NCat::MAINSETTINGS, &BuildColorsPage);
	page->Link("Layout", I18NCat::MAINSETTINGS, &BuildLayoutPage);
	page->Link("Animations", I18NCat::MAINSETTINGS, &BuildAnimationsPage);
	page->Link("Artwork", I18NCat::MAINSETTINGS, &BuildArtworkPage);
	page->Link("Sounds", I18NCat::MAINSETTINGS, &BuildSoundsPage);
	page->Link("Performance", I18NCat::MAINSETTINGS, &BuildPerformancePage);
	page->Link("Guide", I18NCat::MAINSETTINGS, &BuildGuidePage);
}
